{
  "name": "prime-directive",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {"node": ">=24.22.1 <25"},
  "scripts": {
    "start": "node src/server/main.ts",
    "dev:api": "node --watch src/server/main.ts",
    "test": "node --test tests/*.test.ts tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "registry:validate": "node scripts/validate-pr-registry.mjs",
    "check": "npm run registry:validate && npm run typecheck && npm test"
  },
  "devDependencies": {"@types/node": "24.19.2", "typescript": "7.0.2"}
}
